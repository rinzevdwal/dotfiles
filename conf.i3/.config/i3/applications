exec --no-startup-id dex --autostart --environment i3

# Screen locking and power management
# 300 sec : Dim screen
# 320 sec : Lock screen
# 600 sec : Turn screen off
exec_always --no-startup-id xset s 300 20
exec_always --no-startup-id xset dpms 0 600 600
exec_always --no-startup-id xss-lock --notifier ~/.config/scripts/dim-screen.sh -- ~/.config/scripts/lock.sh

exec --no-startup-id nm-applet
exec --no-startup-id udiskie --tray
exec --no-startup-id picom -b

exec_always --no-startup-id feh --bg-fill dotfiles/wallpapers/shaded_landscape.png
exec_always --no-startup-id autorandr --change
exec_always --no-startup-id dunst
exec_always --no-startup-id autotiling
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Create scratch pad terminal
exec_always --no-startup-id ~/.config/scripts/launch_by_class.sh scratch-terminal kitty
for_window [class="scratch-terminal"] move to workspace current, floating enable, resize set 1200 800, move position center, move to scratchpad
