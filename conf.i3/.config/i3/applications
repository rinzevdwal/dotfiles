exec --no-startup-id dex --autostart --environment i3

# Screen locking and power management
# 900 sec : Dim screen
# 930 sec : Lock screen
# 1200 sec : Turn screen off
exec_always --no-startup-id xset s 900 30
exec_always --no-startup-id xset dpms 0 1200 1200
exec_always --no-startup-id xss-lock --notifier ~/.config/scripts/dim-screen.sh -- ~/.config/scripts/lock.sh

exec --no-startup-id nm-applet
exec --no-startup-id udiskie --tray
exec --no-startup-id ~/.config/picom/launch.sh
exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &

exec_always --no-startup-id feh --bg-fill dotfiles/wallpapers/shaded-landscape.png
exec_always --no-startup-id autorandr --change
exec_always --no-startup-id dunst
exec_always --no-startup-id autotiling
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Create scratch pad terminal
exec_always --no-startup-id ~/.config/scripts/launch_by_class.sh scratch-terminal kitty
for_window [class="scratch-terminal"] move to workspace current, \
                                     floating enable, \
                                     resize set 1200 800, \
                                     move position center, \
                                     move to scratchpad

# Custom dialog pop-ups windows
for_window [title="MULTI Choice Dialog"] floating enable, move position center
for_window [title="Initializing Target"] floating enable, move position center
